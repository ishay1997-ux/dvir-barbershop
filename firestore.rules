rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Services & Barbers: Public can read, authenticated admin can manage
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /barbers/{barberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Branches & Settings: Public can read, admin can manage
    match /branches/{branchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Working hours & Blocked dates: Public can read, admin can manage
    match /working_hours/{hourId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blocked_dates/{dateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Appointments: Public can create appointments and read occupied slots
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if request.resource.data.customerName != null &&
                       request.resource.data.customerPhone != null &&
                       request.resource.data.date != null &&
                       request.resource.data.time != null;
      allow update, delete: if request.auth != null;
    }

    // Customers: Public can create/update on booking, admin can read/manage
    match /customers/{customerId} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.resource.data.phone != null;
    }
  }
}
