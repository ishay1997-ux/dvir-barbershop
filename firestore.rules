rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. SERVICES, BARBERS, BRANCHES & SETTINGS
    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /barbers/{barberId} {
      allow read, write: if true;
    }

    match /branches/{branchId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /working_hours/{hourId} {
      allow read, write: if true;
    }

    match /blocked_dates/{dateId} {
      allow read, write: if true;
    }

    match /schedule_overrides/{overrideId} {
      allow read, write: if true;
    }

    // 2. BUSINESSES (Multi-Tenant Profiles)
    match /businesses/{businessId} {
      allow read, write: if true;
    }

    // 3. APPOINTMENTS (Full read/write/delete support for server route handlers)
    match /appointments/{appointmentId} {
      allow read, write, delete: if true;
    }

    // 4. BUG REPORTS & FEEDBACKS
    match /bug_reports/{reportId} {
      allow read, write, delete: if true;
    }

    // 5. CUSTOMERS CRM
    match /customers/{customerId} {
      allow read, write, delete: if true;
    }
  }
}
