rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security and schema validation
    function isAdmin() {
      return request.auth != null;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // 1. SERVICES & BARBERS (Public Read, Admin Only Write)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /barbers/{barberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. BRANCHES, SETTINGS & WORKING HOURS (Public Read, Admin Only Write)
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /working_hours/{hourId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blocked_dates/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. BUSINESSES (Multi-Tenant Profiles)
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. APPOINTMENTS (RLS & Column-Level Validation)
    match /appointments/{appointmentId} {
      // Public cannot read raw full PII collection; Admin has full access
      allow read: if isAdmin();

      // Creation with strict column validation and size limits
      allow create: if 
        // Required fields
        request.resource.data.customerName != null &&
        isValidString(request.resource.data.customerName, 2, 60) &&
        request.resource.data.customerPhone != null &&
        isValidString(request.resource.data.customerPhone, 8, 25) &&
        request.resource.data.date != null &&
        isValidString(request.resource.data.date, 5, 20) &&
        request.resource.data.time != null &&
        isValidString(request.resource.data.time, 3, 10) &&
        // Status on creation cannot be self-approved beyond initial confirmed/pending
        (request.resource.data.status == 'confirmed' || request.resource.data.status == 'pending');

      // Only authenticated admin can update or delete appointments
      allow update, delete: if isAdmin();
    }

    // 5. BUG REPORTS & FEEDBACKS (RLS: Admin Only Read, Strict Column Validation on Create)
    match /bug_reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if
        request.resource.data.fullName != null &&
        isValidString(request.resource.data.fullName, 2, 60) &&
        request.resource.data.phone != null &&
        isValidString(request.resource.data.phone, 8, 25) &&
        request.resource.data.message != null &&
        isValidString(request.resource.data.message, 2, 1500) &&
        (request.resource.data.status == 'new');
    }

    // 6. CUSTOMERS CRM (Admin Only Read/Write)
    match /customers/{customerId} {
      allow read, update, delete: if isAdmin();
      allow create: if 
        request.resource.data.phone != null &&
        isValidString(request.resource.data.phone, 8, 25);
    }
  }
}
